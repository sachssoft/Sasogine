<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sachssoft.Sasogine.Controls</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <SasogineBuildConfiguration Condition="'$(SasogineBuildConfiguration)' == ''">Release</SasogineBuildConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Projects/UI/*.cs;../../../Projects/UI/Styling/*.cs;../../../Projects/UI/Layouts/*.cs;../../../Projects/UI/Input/*.cs;../../../Projects/UI/Drawing/*.cs;../../../Projects/UI/Binding/*.cs" />
    <Reference Include="Sachssoft.Sasogine"><HintPath>../../../Projects/Basic/bin/$(SasogineBuildConfiguration)/net10.0/Sachssoft.Sasogine.dll</HintPath></Reference>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
  </ItemGroup>
</Project>
