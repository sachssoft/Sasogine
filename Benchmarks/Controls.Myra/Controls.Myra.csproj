<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sachssoft.Engine.Controls.Benchmarks</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <UseMonoGameNative>false</UseMonoGameNative>
    <SasogineBuildConfiguration Condition="'$(SasogineBuildConfiguration)' == ''">Release</SasogineBuildConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Engine/**/*.cs" />
    <PackageReference Include="Myra" Version="1.6.8" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
    <Reference Include="Sachssoft.Sasogine"><HintPath>../../Projects/Basic/bin/$(SasogineBuildConfiguration)/net10.0/Sachssoft.Sasogine.dll</HintPath></Reference>
    <ProjectReference Include="Engine/Sachssoft.Sasogine.Controls.csproj" />
  </ItemGroup>
  <ItemGroup><None Update="Licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
