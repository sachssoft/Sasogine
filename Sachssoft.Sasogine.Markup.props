<Project>

	<Import Project="Sachssoft.Sasogine.Package.props" />

	<PropertyGroup>
		<!-- General -->
		<RootNamespace>Sachssoft.Sasogine.Markup</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- AOT / Trimming -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- NuGet Metadata -->
		<Description>
			Markup and serialization support for the Sasogine game engine, including XML and JSON document handling and resource markup loading.
		</Description>

		<PackageReleaseNotes>
			Introduces the Sasogine Markup and serialization infrastructure.
		</PackageReleaseNotes>

		<PackageTags>
			Sasogine;Markup;Serialization;Resources;XML;JSON;FrameSet;TextureAtlas;MonoGame;GameEngine;Framework;AOT;Trimming
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Sachssoft.Sasogine.DesktopGL"
						  Version="$(VersionPrefix)-$(VersionSuffix)" />
		<PackageReference Include="Sachssoft.Sasodoc"
						  Version="1.0.0" />
	</ItemGroup>

</Project>