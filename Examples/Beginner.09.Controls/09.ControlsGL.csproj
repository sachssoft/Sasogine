<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sachssoft.Engine.Controls.Examples</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
    <NuGetAudit>false</NuGetAudit>
    <UseMonoGameNative>false</UseMonoGameNative>
    <SasogineBuildConfiguration Condition="'$(SasogineBuildConfiguration)' == ''">$(Configuration)</SasogineBuildConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.1" />
    <ProjectReference Include="..\..\Projects\UI\Sachssoft.Sasogine.Controls.csproj" Condition="'$(UseBuiltEngine)' != 'true'" />
  </ItemGroup>
  <!-- Optional fast path: use the engine assemblies already built in this checkout. -->
  <ItemGroup Condition="'$(UseBuiltEngine)' == 'true'">
    <Reference Include="Sachssoft.Sasogine">
      <HintPath>..\..\Projects\Basic\bin\$(SasogineBuildConfiguration)\$(TargetFramework)\Sachssoft.Sasogine.dll</HintPath>
    </Reference>
    <Reference Include="Sachssoft.Sasogine.Controls">
      <HintPath>..\..\Projects\UI\bin\$(SasogineBuildConfiguration)\$(TargetFramework)\Sachssoft.Sasogine.Controls.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Projects\UI\Skins\**\*.png;..\..\Projects\UI\Skins\**\*.xml" Link="Skins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Content\Fonts\*.ttf;Content\Fonts\*.otf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
