<Project>

	<Import Project="Sachssoft.Sasogine.Package.props" />

	<PropertyGroup>
		<!-- General -->
		<RootNamespace>Sachssoft.Sasogine</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- AOT / Trimming -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- NuGet Metadata -->
		<Description>
			Sasogine is a lightweight and flexible game engine framework based on MonoGame.
		</Description>

		<PackageReleaseNotes>
			Sasogine Alpha release.
		</PackageReleaseNotes>

		<PackageTags>
			MonoGame;GameEngine;Framework;AOT;Trimming
		</PackageTags>

		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Build\Sachssoft.Sasogine.Analyzers\Sachssoft.Sasogine.Analyzers.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FontStashSharp.MonoGame" Version="1.5.6" />
		<PackageReference Include="LibTessDotNet" Version="1.1.15" />
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="NLayer" Version="1.16.0" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
	</ItemGroup>

</Project>