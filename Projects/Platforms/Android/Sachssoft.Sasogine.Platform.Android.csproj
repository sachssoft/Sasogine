<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android uses MonoGame's dedicated mobile framework package in 3.8.5.1. -->
		<UseMonoGameNative>false</UseMonoGameNative>
	</PropertyGroup>

	<Import Project="..\..\..\Sachssoft.Sasogine.Package.props" />

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net9.0-android;net10.0-android</TargetFrameworks>
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<MonoGamePlatform>Android</MonoGamePlatform>

		<PackageId>Sachssoft.Sasogine.Platform.Android</PackageId>
		<Title>Sasogine Platform Android</Title>
		<Description>Android platform services for the Sasogine game engine.</Description>
		<PackageTags>Sasogine;Platform;Android;Mobile;GameEngine</PackageTags>

		<RootNamespace>Sachssoft.Engine.Platform.Android</RootNamespace>
		<DefineConstants>$(DefineConstants);PLATFORM_ANDROID;DEVICE_MOBILE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Basic\Sachssoft.Sasogine.csproj" />
	</ItemGroup>

</Project>
