<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\Sachssoft.Sasogine.props" />

	<PropertyGroup>
		<PackageId>Sachssoft.Sasogine</PackageId>
		<Title>Sasogine</Title>

		<Description>
			Sasogine is a lightweight and flexible game engine framework based on MonoGame.
		</Description>

		<PackageTags>
			MonoGame;Sasogine;GameEngine;Framework;AOT;Trimming
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!--<None Include="..\..\README.md" Pack="true" PackagePath="/" />-->
		<None Include="..\..\AGENTS.md" Link="AGENTS.md" />
		<None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\..\Assets\Fonts\Noto_Sans\NotoSans-*.ttf;..\..\Assets\Fonts\Noto_Serif\NotoSerif-*.ttf;..\..\Assets\Fonts\Noto_Sans_Mono\NotoSansMono-*.ttf">
			<LogicalName>Sachssoft.Engine.Graphics.Text.Fonts.%(Filename)%(Extension)</LogicalName>
			<WithCulture>false</WithCulture>
		</EmbeddedResource>
		<EmbeddedResource Include="..\..\Assets\Fonts\OFL-Noto.txt" LogicalName="Sachssoft.Engine.Graphics.Text.Fonts.OFL-Noto.txt" />
		<None Include="..\..\Assets\Fonts\OFL-Noto.txt" Pack="true" PackagePath="licenses/" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="FontStashSharp.MonoGame" Version="1.6.2" />
	  <PackageReference Update="MonoGame.Framework.Native" Version="3.8.6" />
	</ItemGroup>

</Project>
