<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMonoGameNative>false</UseMonoGameNative>
	</PropertyGroup>

	<Import Project="..\Sasogine.Package.props" />

	<PropertyGroup>
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net10.0</TargetFramework>

		<PackageId>Sachssoft.Sasogine.Templates</PackageId>
		<Title>Sasogine Templates</Title>
		<Description>Project templates for the Sasogine game engine.</Description>
		<PackageTags>dotnet-new;templates;MonoGame;Sasogine;GameEngine;Framework</PackageTags>

		<!-- Template package configuration. -->
		<PackageType>Template</PackageType>
		<IsPackable>true</IsPackable>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ContentTargetFolders>content</ContentTargetFolders>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Sasogine.*/**/*.cs" />

		<Content Include="Sasogine.*/**/*"
				 Exclude="Sasogine.*/**/bin/**;Sasogine.*/**/obj/**"
				 Pack="true"
				 PackagePath="content/%(Identity)" />
	</ItemGroup>

</Project>
