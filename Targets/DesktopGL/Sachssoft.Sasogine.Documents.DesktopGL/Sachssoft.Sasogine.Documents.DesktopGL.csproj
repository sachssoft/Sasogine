<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<PackageOutputPath>..\..\..\Packages</PackageOutputPath>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<PackageId>Sachssoft.Sasogine.Documents.DesktopGL</PackageId>
		<Title>Sasogine Documents</Title>
		<Description>
			Document and serialization support for the Sasogine game engine.
		</Description>

		<PackageTags>
			Sasogine;Documents;Serialization;Resources;XML;JSON;Binary;GameEngine;Framework
		</PackageTags>
	</PropertyGroup>

	<Import Project="..\..\..\Sachssoft.Sasogine.Documents.props" />

	<PropertyGroup>
		<DefineConstants>
			$(DefineConstants);
			BACKEND_GL;
			DEVICE_DESKTOP
		</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\..\Projects\Documents\**\*.cs">
			<LinkBase>Documents</LinkBase>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\README.md" Pack="true" PackagePath="/" />
		<None Include="..\..\..\LICENSE.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>