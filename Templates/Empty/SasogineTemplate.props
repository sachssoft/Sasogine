
<Project>
  <PropertyGroup>
    <!-- Gemeinsame Produkt- und Versionsinformationen. -->
    <Product>SasogineTemplate</Product>
    <Title>SasogineTemplate</Title>
    <Description></Description>
    <Authors>YourName</Authors>
    <Company>YourCompany</Company>
    <Copyright></Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>

    <!-- Allgemeine Projekteinstellungen. -->
    <RootNamespace>SasogineTemplate</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Native-AOT- und Trimming-Kompatibilität. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
</Project>
